{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenColorHub",
  "version": "0.3.0",
  "identifier": "dev.msartore.opencolorhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenColorHub",
        "visible": false,
        "width": 1240,
        "height": 830,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#07090b",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Massimiliano Sartore",
    "copyright": "© 2026 Massimiliano Sartore",
    "category": "Utility",
    "shortDescription": "Fan and ARGB control for Colorful motherboards",
    "longDescription": "OpenColorHub controls the NCT5584D Super I/O (fan curves, tachometers, temperatures) and the onboard Colorful RGB controller (onboard LEDs, 12V and 5V ARGB headers) from a native desktop UI. Hardware access is Linux-only; other platforms run the built-in simulator.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE.md",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
