<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Tauri's default manifest, plus an explicit execution level.

  Without a requestedExecutionLevel Windows assumes asInvoker and never shows a
  consent prompt. requireAdministrator makes Windows raise UAC before the
  process starts, which is the only way to get a *visible* prompt on every
  launch — the alternative used by some vendor utilities (a hidden scheduled
  task at RunLevel::Highest) grants admin with no prompt at all.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="MassimilianoSartore.colorutil"
    version="1.0.0.0"
    processorArchitecture="*"
  />
  <description>colorutil — fan and ARGB control for Colorful motherboards</description>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
