# Rust
/target
**/*.rs.bk

# Frontend
node_modules/
dist/
.vite/

# Tauri
src-tauri/gen/
src-tauri/target/

# Tooling / OS
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
.idea/
.vscode/*
!.vscode/extensions.json

# Local demo state
*.state
sim-fan.json

# Installed/portable app state — machine-specific settings, presets and caches.
# These live beside the executable in portable mode and must never be published.
/config/
/data/
settings.json
active-setup.json
setups.json
opencolorhub.portable

# Secrets and credentials — keep keys out of the public repo.
*.key
*.pem
*.p12
*.pfx
*.asc
.npmrc
.yarnrc
credentials.json

# Extracted vendor firmware/drivers from reverse-engineering. The only shipped
# blob is crates/colorctl-core/resources/LpcIO.bin (tracked, LGPL-2.1).
*.sys
*.cat
*.efi
*.rom
/firmware/
/vendor-extract/
/reverse-engineering/
/polychrome-re/

# Generated by the release job for the CLI package
/completions

# Build outputs — installers, portable packages and linker artefacts never go
# into the repository; `npx tauri build` writes them under /target.
*.exe
*.dll
*.msi
*.msix
*.appx
*.AppImage
*.deb
*.rpm
*.dmg
*.pdb
*.res
*.zip
*.tar.gz
*.tgz
*.7z
build/
bundle/
out/
pkg/

# Self-updater staging downloaded at runtime, never source.
/update/
SHA256SUMS.txt
latest.json
