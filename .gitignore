# Rust
/target
**/*.rs.bk

# NSH-generated types, runners and bundles
.nsh/
nsh/target/

# The Tauri frontend is gone: no npm build and no WebView2 runtime.
# These names are ignored so files from an older branch cannot be added back
# by accident (they are the only source of webview dependencies here).
node_modules/
dist/
.vite/
src-tauri/

# Tooling / OS
.DS_Store
Thumbs.db
*.log
.env
.env.local
.idea/
.vscode/*
!.vscode/extensions.json

# Local demo state
*.state
sim-fan.json

# Generated by the release job for the CLI package
/completions

# Build outputs — installers and packages never go into the repository.
*.exe
*.dll
*.msi
*.msix
*.appx
*.AppImage
*.deb
*.rpm
*.dmg
*.pdb
build/
bundle/
out/
pkg/
